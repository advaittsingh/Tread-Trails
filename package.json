{
  "name": "tread-trails-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend,admin -c green,cyan,magenta \"pnpm dev:backend\" \"pnpm dev:frontend\" \"pnpm dev:admin\"",
    "dev:backend": "pnpm --filter @tread-trails/backend dev",
    "dev:frontend": "pnpm --filter @tread-trails/frontend dev",
    "dev:admin": "pnpm --filter @tread-trails/admin dev",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build:backend": "pnpm --filter @tread-trails/backend build",
    "build:frontend": "pnpm --filter @tread-trails/frontend build",
    "build:admin": "pnpm --filter @tread-trails/admin build",
    "lint:packages": "pnpm -r --filter \"./packages/*\" lint",
    "lint:backend": "pnpm --filter @tread-trails/backend lint",
    "lint:frontend": "pnpm --filter @tread-trails/frontend lint",
    "lint:admin": "pnpm --filter @tread-trails/admin lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
