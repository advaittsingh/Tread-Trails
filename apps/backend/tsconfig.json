{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "paths": {
      "@/*": ["../../*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/lib/static-data.runtime.ts"]
}
